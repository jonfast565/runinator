{
  "uid": "runinator-operations",
  "title": "Runinator Operations",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP traffic by status class",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum by (status_class) (rate({__name__=~\"runinator_ws_http_requests.*\"}[5m]))", "legendFormat": "{{status_class}}" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate({__name__=~\"runinator_ws_http_request_duration_ms.*_bucket\"}[5m])))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (queue) ({__name__=~\"runinator_engine_queue_depth.*\"})", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Oldest queued item (seconds)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "refId": "A", "expr": "max by (queue) ({__name__=~\"runinator_engine_queue_oldest_age_seconds.*\"})", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Background loop freshness (seconds)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "refId": "A", "expr": "time() - max by (loop) ({__name__=~\"runinator_engine_loop_last_success_unixtime.*\"})", "legendFormat": "{{loop}}" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Replica fleet",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "refId": "A", "expr": "sum by (kind, status) ({__name__=~\"runinator_engine_replicas.*\"})", "legendFormat": "{{kind}} {{status}}" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker capacity and in-flight actions",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "sum({__name__=~\"runinator_worker_capacity.*\"})", "legendFormat": "capacity" },
        { "refId": "B", "expr": "sum({__name__=~\"runinator_worker_actions_in_flight.*\"})", "legendFormat": "in flight" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Broker errors / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [{ "refId": "A", "expr": "sum by (backend, channel, op) (rate({__name__=~\"runinator_broker_operations.*\",outcome=\"error\"}[5m]))", "legendFormat": "{{backend}} {{channel}} {{op}}" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "VM continuation outcomes / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [{ "refId": "A", "expr": "sum by (outcome) (rate({__name__=~\"runinator_vm_continuations_driven.*\"}[5m]))", "legendFormat": "{{outcome}}" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "VM drive p95 and failures / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"runinator_vm_drive_duration_ms.*_bucket\"}[5m])))", "legendFormat": "drive p95 (ms)" },
        { "refId": "B", "expr": "sum(rate({__name__=~\"runinator_vm_driver_failures.*\"}[5m]))", "legendFormat": "failures / sec" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Runtime service CPU (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        { "refId": "A", "expr": "sum by (service) ({__name__=~\"runinator_resource_host_cpu_percent.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} host" },
        { "refId": "B", "expr": "sum by (service) ({__name__=~\"runinator_resource_process_cpu_percent.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} process" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Runtime service memory (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "refId": "A", "expr": "sum by (service) ({__name__=~\"runinator_resource_host_memory_used_bytes.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} host" },
        { "refId": "B", "expr": "sum by (service) ({__name__=~\"runinator_resource_process_memory_used_bytes.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} process" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Runtime memory pressure and load",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        { "refId": "A", "expr": "max by (service) ({__name__=~\"runinator_resource_host_memory_percent.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} memory %" },
        { "refId": "B", "expr": "max by (service) ({__name__=~\"runinator_resource_load_(1|5|15).*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} {{__name__}}" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Runtime network throughput (bytes/sec)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        { "refId": "A", "expr": "sum by (service) ({__name__=~\"runinator_resource_network_(receive|transmit)_bytes_per_second.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} {{__name__}}" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Runtime disk capacity and I/O",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "targets": [
        { "refId": "A", "expr": "max by (service, mount_point) ({__name__=~\"runinator_resource_disk_(total|available)_bytes.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} {{mount_point}} {{__name__}}" },
        { "refId": "B", "expr": "sum by (service, mount_point) ({__name__=~\"runinator_resource_disk_(read|written)_bytes_per_second.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} {{mount_point}} {{__name__}}" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Runtime GPU utilization and memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        { "refId": "A", "expr": "max by (service, gpu) ({__name__=~\"runinator_resource_gpu_utilization_percent.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} {{gpu}} utilization" },
        { "refId": "B", "expr": "max by (service, gpu) ({__name__=~\"runinator_resource_gpu_memory_(used|total)_bytes.*\", service=~\"Runinator (Worker|Waker|Background Worker|Archiver)\"})", "legendFormat": "{{service}} {{gpu}} {{__name__}}" }
      ]
    }
  ]
}
