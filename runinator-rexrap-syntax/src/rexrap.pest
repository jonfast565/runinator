// RexRap grammar. This file is the canonical, human-readable spec of the language.
// statements are wired into a node graph by lowering; sequence implies the forward
// edge, blocks expand into control nodes, and arrows make transitions explicit.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ ("//" ~ (!"\n" ~ ANY)*) | ("/*" ~ (!"*/" ~ ANY)* ~ "*/") }

// The version header identifies a RexRap source document independently of a workflow's own
// version metadata. It is optional while authoring a single buffer, but pack writers emit it and
// formatters preserve it when present.
document = { SOI ~ language_decl? ~ document_item* ~ EOI }
// The console accepts a small top-level module form as well as a complete document: definitions
// may be followed by one bare runtime `do` block.  It is deliberately separate from `document`:
// a normal document still requires a workflow, while the console needs a useful function-only
// cell to publish its session library.
console_module_document = { SOI ~ language_decl? ~ func_def* ~ run_block? ~ EOI }
language_decl = { "language" ~ "rexrap-1" }
expr_document = { SOI ~ expr ~ EOI }
cond_document = { SOI ~ cond ~ EOI }
compute_document = { SOI ~ compute_block ~ EOI }

// a top-level function definition: an optional `@recursive(max_depth: N)` cap, then a typed
// signature and a body. params reuse the parameter-field shape (`name: type` with an optional `?`
// or `= default`). the body after `=` is either a single expression or a compute-style statement
// block `{ let …; … ; return e }` reusing the compute lines. an object literal `{ k: v }` still
// parses as an expression because `compute_line` cannot consume the `:`; a brace body must hold at
// least one statement so `{}` stays an empty object.
// a pure `fn` is `= <expr|block>` and folds in the compute VM. a `task fn` is `do { … }` and is a
// named region of runtime statements inlined into the graph at each call site. `task` declares
// that the body does runtime work; it is NOT a color, because the caller still chooses the
// scheduling (`f(...)` joins inline, `async f(...)` yields a `task[T]`).
func_def     = { fn_recursive? ~ task_kw? ~ "fn" ~ ident ~ "(" ~ fn_params? ~ ")" ~ ("->" ~ type_expr)? ~ (("=" ~ fn_body) | run_block) }
task_kw      = @{ "task" ~ !(ASCII_ALPHANUMERIC | "_") }
fn_body      = { fn_block | expr }
fn_block     = { "{" ~ compute_line+ ~ "}" }
fn_recursive = { "@recursive" ~ "(" ~ "max_depth" ~ ":" ~ integer ~ ")" }
fn_params    = { fn_param ~ ("," ~ fn_param)* ~ ","? }
fn_param     = { ident ~ optional_mark? ~ ":" ~ type_expr ~ field_default? }

// a `.rexraps` secrets/config file: a flat list of `secret`/`config` declarations addressing a
// dotted `scope.name`, each assigned a literal value. mirrors rexrap's `secret.*` / `config.*`
// reference surface. the value reuses the expression grammar but must be a pure literal (no refs
// or interpolation); the parser enforces that.
secrets_document = { SOI ~ secret_decl* ~ EOI }
secret_decl      = { secret_kind ~ path ~ "=" ~ expr }
secret_kind      = { "secret" | "config" }

// a `.rexrapp` pipeline file: one or more `pipeline "Name" { ... }` blocks. each declares member
// workflows (`workflow "Name"`) and directed links (`"A" -> "B" on <selector>`) plus authoring
// defaults. lowers to a portable `PipelineBundle`; the web service resolves member names to workflow
// ids and materializes links as managed `chained` triggers stamped with the pipeline id at import.
// the grammar only expresses well-formed pipelines; the lowering rejects empty/danging references.
pipeline_document       = { SOI ~ pipeline_decl* ~ EOI }
pipeline_decl           = { "pipeline" ~ string ~ "{" ~ pipeline_item* ~ "}" }
pipeline_item           = { pipeline_desc | pipeline_on_failure | pipeline_max_depth | concurrency_decl | pipeline_trigger | pipeline_member | pipeline_join | pipeline_link }
pipeline_desc           = { "description" ~ string }
pipeline_on_failure     = { "on_failure" ~ pipeline_failure_policy }
pipeline_failure_policy = { "halt" | "continue" }
pipeline_max_depth      = { "max_depth" ~ integer }
// `on_failure <mode>` on a member overrides the pipeline's default failure mode for that member only
// (powershell-$erroractionpreference-style: what happens to the *pipeline run* when this workflow
// fails). absent, it takes the pipeline's default_failure_mode at import.
pipeline_member               = { "workflow" ~ string ~ ("on_failure" ~ pipeline_member_failure_mode)? }
pipeline_member_failure_mode  = { "stop" | "silently_continue" | "continue" | "inquire" }
pipeline_link           = { string ~ "->" ~ string ~ ("on" ~ pipeline_link_selector)? ~ ("with" ~ object)? }
pipeline_link_selector  = { "success" | "complete" | "failure" }
pipeline_join           = { "join" ~ string ~ pipeline_join_mode ~ ("with" ~ object)? }
pipeline_join_mode      = { "first_success" | "all" | "any" }
// pipeline-level triggers. `trigger cron "<expr>"` schedules a pipeline run; `trigger on_success
// workflow "<name>"` (or on_failure/on_complete, workflow|pipeline) starts this pipeline when the
// named source reaches that terminal state (chained-to-pipeline).
pipeline_trigger          = { "trigger" ~ (pipeline_cron_trigger | pipeline_chained_trigger) }
pipeline_cron_trigger     = { "cron" ~ string ~ trigger_disabled? }
pipeline_chained_trigger  = { chain_event ~ pipeline_chain_source ~ string ~ trigger_disabled? }
pipeline_chain_source     = { "workflow" | "pipeline" }

document_item = {
    func_def
  | namespace_block
  | workflow
  | namespace_decl
  | workflow_decl
  | params_block
  | import_decl
  | trigger_decl
  | notify_decl
  | concurrency_decl
  | watch_decl
  | interrupt_decl
  | correlate_decl
  | type_decl
  | alias_decl
  | start_decl
  | run_block
  | join_decl
  | stmt
}

// `do { … }` is the lexical runtime block: the thread of control a run follows. It holds the
// statement sequence a workflow executes, separating it from the header declarations above.
run_block = { do_kw ~ "{" ~ (join_decl | stmt)* ~ "}" }
do_kw     = @{ "do" ~ !(ASCII_ALPHANUMERIC | "_") }

// `join <name> { … }` is an explicit named continuation — a labelled region a `continue <name>`
// route hands control to. It is not a parallel barrier; `parallel { … } join <policy>` is.
join_decl = { join_kw ~ ident ~ "{" ~ stmt* ~ "}" }
join_kw   = @{ "join" ~ !(ASCII_ALPHANUMERIC | "_") }
namespace_block = { "namespace" ~ ns_path ~ "{" ~ workflow* ~ "}" }
workflow_decl = { "workflow" ~ string ~ version? ~ returns_decl? }
workflow = { "workflow" ~ string ~ version? ~ returns_decl? ~ "{" ~ params_block? ~ workflow_item* ~ "}" }
workflow_item = _{ import_decl | trigger_decl | notify_decl | concurrency_decl | watch_decl | interrupt_decl | correlate_decl | type_decl | alias_decl | start_decl | run_block | join_decl }
returns_decl = { "returns" ~ type_expr }

// the namespace this workflow's identity lives in. a dotted path qualifying the workflow name so
// subflow targets resolve unambiguously across packs; falls back to the pack name on import when
// absent. render-only surface that rides in metadata.
namespace_decl = { "namespace" ~ ns_path }

// `import <path> (as <alias>)?` opens a namespace into local scope. `import std.strings` makes
// `upper(x)` callable bare; `import std.strings as s` binds `s.upper(x)`; `import some_pack` brings
// another pack's workflows into subflow scope. pure surface sugar carried in metadata; the compiled
// graph only ever holds fully-resolved names.
import_decl = { "import" ~ ns_path ~ ("as" ~ ident)? }

// a dotted namespace path (`std.strings`, `some_pack.helpers`). atomic so it is captured whole and
// split by the parser.
ns_path = @{ ident ~ ("." ~ ident)* }

// named type declarations, reusable for parameter/let typing. a struct shorthand (`type Cart { ... }`)
// or an alias (`type Ids = int[]`). render-only surface: declared names resolve to RuninatorType
// during lowering and the declarations ride in metadata so decompile can re-emit them.
type_decl = { "type" ~ type_named ~ ( type_struct | ("=" ~ type_expr) ) }
version  = @{ "v" ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+){0,2} }

// header trigger declarations. a `trigger cron "<expr>"` schedules runs of this workflow on the
// cron expression; an optional `with { ... }` object supplies the run parameters. triggers belong to
// their workflow, so they are carried inside the compiled definition and materialized on import.
// a workflow-level cancellation guard: when `cond` holds, the run jumps to the handler node. it is
// re-evaluated on every reducer drive (including while parked), so it catches state changes a fixed
// checkpoint would miss. fires at most once per run.
watch_decl = { "watch" ~ cond ~ "->" ~ target }

// an interrupt handler: when `source` fires, the run's thread of control is suspended, the block
// runs beside it on its own cursor, and a `resume` inside the block hands control back. the block
// is a region rather than a loose node reference so its entry and its exit are both well defined —
// the first statement is where the interrupt enters, and every path out ends at a `resume`.
//
// the sources, in the reducer's own precedence order. most are read off the node state the drive
// finds; `external` and `orphan_signal` are asked for from outside the run. adding one is a new
// alternative here, a variant on `InterruptSource`, and an arm in the reducer's `detect`.
//
// `orphan_signal` is listed before `wake` only because pest takes the first matching alternative and
// these must not prefix one another.
interrupt_decl   = { "interrupt" ~ "on" ~ interrupt_source ~ interrupt_disabled? ~ block }
interrupt_disabled = { "disabled" }
interrupt_source = {
    "external"
  | "orphan_signal"
  | "wake"
  | "timeout"
  | "retry"
  | "failure"
  | "resolved"
  | "child"
}

// declares the value this workflow's runs are awaitable by. the expression (over `input.*`, a step
// output, etc.) is resolved as the run progresses and stamped write-once onto the run's correlation
// key, so `await workflow ... key <expr>` in another workflow can match it. `correlate key input.batch_id`.
correlate_decl = { "correlate" ~ "key" ~ expr }

// a `trigger cron "<expr>"` schedules this workflow; a `trigger on_success workflow "<name>"`
// (or on_failure/on_complete) starts another workflow when this one reaches that terminal state.
trigger_decl = { "trigger" ~ (cron_trigger | chained_trigger) }
cron_trigger = { "cron" ~ expr ~ ("with" ~ object)? ~ trigger_option* }
chained_trigger = { chain_event ~ "workflow" ~ expr ~ ("with" ~ object)? ~ trigger_disabled? }
chain_event = { "on_success" | "on_failure" | "on_complete" }
trigger_option = { trigger_disabled | trigger_blackout | trigger_catchup }
trigger_disabled = { "disabled" }
trigger_blackout = { "blackout" ~ expr ~ "to" ~ expr }

// what happens to cron slots that came due while nothing was firing them. `fire_once` (the default)
// collapses the backlog into one run, `fire_all` replays each missed slot up to `max`, and `skip`
// abandons slots later than `grace`.
trigger_catchup = { "catchup" ~ catchup_policy ~ catchup_option* }
catchup_policy = { "fire_all" | "fire_once" | "skip" }
catchup_option = { catchup_grace | catchup_max }
catchup_grace = { "grace" ~ duration }
catchup_max = { "max" ~ number }

// `concurrency <n> on_conflict <policy>` caps how many runs of this workflow may overlap. the
// policy decides what a firing does when the cap is reached; declining to create the run is
// cheaper and safer than creating one that immediately parks.
concurrency_decl = { "concurrency" ~ number ~ ("on_conflict" ~ concurrency_policy)? }
concurrency_policy = { "cancel_previous" | "skip" | "queue" | "allow" }

// `notify on <event> -> <channel> "<target>"` declares a failure-alerting policy for this workflow.
// the duration events (`sla`, `parked`) need an `after <duration>` threshold to be evaluable; the
// transition events (`failure`, `retry_exhausted`) fire on the terminal transition itself. policies
// ride in the compiled definition and are materialized as pack-managed rows on import, like triggers.
notify_decl = { "notify" ~ "on" ~ notify_event ~ "->" ~ notify_channel ~ expr ~ notify_option* }
notify_event = { "failure" | "retry_exhausted" | "sla" | "parked" }
notify_channel = { "slack" | "email" | "app" }
notify_option = { notify_after | notify_severity | notify_with | notify_disabled }
notify_after = { "after" ~ duration }
notify_severity = { "severity" ~ notify_level }
notify_level = { "info" | "warning" | "critical" }
notify_with = { "with" ~ object }
notify_disabled = { "disabled" }

// reusable named argument groups, declared in the workflow header. an alias binds a name to an
// object of argument values (typically shared `config.*`/`secret.*` refs); `...name` then spreads
// those entries into an action call's argument list. purely surface sugar: spreads are expanded
// before sema and lowering, so the json graph never sees aliases.
alias_decl = { "alias" ~ ident ~ "=" ~ object }

// optional explicit entry edge. when omitted the first statement is the entry; when present it
// names the entry node directly, surfacing the otherwise-synthetic `start` node.
start_decl = { "start" ~ "->" ~ target }

// parameter typing ----------------------------------------------------------

// top-level workflow parameters may carry a default: `name: type = expr`. the default is an
// ordinary expression (literal, `params.*`/`config.*`/`run.*` ref, `secret.*`, object/array)
// evaluated at run start when the field is omitted. nested struct fields (`type_field`) never
// take a default.
params_block = { "params" ~ "{" ~ params_field* ~ type_additional? ~ "}" }
params_field  = { (ident | string) ~ optional_mark? ~ ":" ~ type_expr ~ field_default? ~ ","? }
field_default = { "=" ~ expr }

type_field   = { (ident | string) ~ optional_mark? ~ ":" ~ type_expr ~ ","? }
optional_mark = { "?" }

type_expr    = { type_union }
type_union   = { type_range ~ ("|" ~ type_range)* }
type_range   = { type_postfix ~ ("range" ~ range_bounds)? }
range_bounds = { range_min? ~ ".." ~ range_max? }
range_min    = { type_bound }
range_max    = { type_bound }
type_bound   = { duration | number }
type_postfix = { type_atom ~ array_suffix* }
array_suffix = { "[" ~ "]" }
type_atom    = { type_task | type_enum | type_map | type_function | type_struct | type_named }
// A task handle is an awaitable result. `task` elides its result parameter and lets semantic
// inference recover it from the assigned runtime call; `task[T]` fixes it explicitly.
type_task    = { "task" ~ ("[" ~ type_expr ~ "]")? }
// a first-class function type `function<(T, ...) -> R>`. lambdas infer this shape; the annotation
// lets a `let`/user-`fn` parameter declare it (e.g. higher-order user functions).
type_function = { "function" ~ "<" ~ "(" ~ (type_expr ~ ("," ~ type_expr)*)? ~ ")" ~ "->" ~ type_expr ~ ">" }
type_enum    = { "enum" ~ "[" ~ enum_lit ~ ("," ~ enum_lit)* ~ ","? ~ "]" }
enum_lit     = { string | number | boolean | null_lit }
type_map     = { "map" ~ "<" ~ type_expr ~ ">" }
type_struct  = { "{" ~ type_field* ~ type_additional? ~ "}" }
type_additional = { "..." ~ ":" ~ type_expr ~ ","? }
type_named   = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// statements ---------------------------------------------------------------

stmt = { annotation* ~ node_decl? ~ async_kw? ~ stmt_body ~ compensate_clause? ~ transitions? }
// `async <call>` schedules the call as a task instead of joining it inline. Asyncness is a
// property of the call *site*, never of the callee: the same provider action, subflow, or
// library function is callable both ways, so nothing in the language is ever written twice.
async_kw = @{ "async" ~ !(ASCII_ALPHANUMERIC | "_") }

// `compensate <provider.fn(args)>` attaches a compensating action to an action node. when a later
// step drives the run to a failed terminal, the engine runs the recorded compensations of every
// already-succeeded node in reverse (saga rollback).
compensate_clause = { "compensate" ~ annotation* ~ action_stmt }

// every step attribute is written `@name` or `@name(args)`, prefixed to the statement. there is
// exactly one attribute surface: the fluent `.timeout(...)`/`.retry(...)` postfix chain is gone.
// `@id`, `@skip`, `@lock`, and `@deadline` describe the graph node; `@timeout`, `@retry`, `@tags`,
// `@mcp`, `@runner`, `@idempotent`, and `@reentry` describe the step's execution.
annotation = { "@" ~ ann_name ~ ("(" ~ mod_arg_list? ~ ")")? }
ann_name   = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// A graph-node binding. `let name = statement` binds the step's result; `let name: T = statement`
// declares its type. A plain runtime call is synchronous and binds `T`; an `async` call binds
// `task[T]` and must be joined by `await` (or discarded by `detach`).
node_decl = { let_kw ~ ident ~ (":" ~ type_expr)? ~ "=" }
let_kw    = @{ "let" ~ !(ASCII_ALPHANUMERIC | "_") }

stmt_body = {
    if_stmt
  | for_stmt
  | while_stmt
  | until_stmt
  | match_stmt
  | toggle_stmt
  | split_stmt
  | parallel_stmt
  | try_stmt
  | resume_stmt
  | race_stmt
  | map_stmt
  | wait_cond_stmt
  | wait_stmt
  | output_stmt
  | emit_stmt
  | yield_stmt
  | input_stmt
  | approval_stmt
  | gate_stmt
  | signal_stmt
  | assert_stmt
  | transform_stmt
  | audit_stmt
  | checkpoint_stmt
  | mutex_stmt
  | throttle_stmt
  | cooldown_stmt
  | await_stmt
  | debounce_stmt
  | collect_stmt
  | barrier_stmt
  | circuit_breaker_stmt
  | event_source_stmt
  | config_stmt
  | return_stmt
  | detach_stmt
  | fail_stmt
  | subflow_stmt
  | compute_stmt
  | action_stmt
  | task_call_stmt
}

// a call to a `task fn`: a single undotted name, so `action_stmt` (two-or-more dotted segments)
// always wins for a provider call. the body is inlined at this site, and the call-site `async`
// marker — not the callee — decides whether the run joins it inline or takes a `task[T]`.
task_call_stmt = { ident ~ "(" ~ arg_list? ~ ")" }

// an imperative `compute` block. lowers to an action node invoking the `std` standard library:
// `std.run` (pure, reduced in-process) when every called function is pure, `std.exec` (effectful,
// dispatched to the worker) when any called function has side effects. a foreign `do` block
// carries fenced source verbatim and lowers to `std.code`, executed by the worker through docker
// using the admin-configured runtime for that language.
// `compute` lines reuse the one expression/condition grammar; the only block-specific surface is
// `let`/`return`/`goto`/`if`. `do { … }` is the *runtime* block and is a different construct.
compute_stmt  = { compute_kw ~ (foreign_compute | compute_block) }
// `compute` must not swallow the leading identifier of a longer word.
compute_kw    = @{ "compute" ~ !(ASCII_ALPHANUMERIC | "_") }
foreign_compute = { string ~ raw_block }
compute_block = { "{" ~ compute_line* ~ "}" }
compute_line  = { compute_let | compute_return | compute_goto | compute_if | compute_expr_stmt }
compute_let   = { "let" ~ ident ~ (":" ~ type_expr)? ~ "=" ~ expr }
compute_return = { "return" ~ expr }
compute_goto  = { "goto" ~ target }
compute_if    = { "if" ~ cond ~ compute_block ~ ("else" ~ compute_block)? }
compute_expr_stmt = { expr }

// arithmetic operators, shared by the sum/term expression levels below.
add_op   = { "+" | "-" }
mul_op   = { "*" | "/" | "%" }

// provider/function names may contain internal hyphens (e.g. `ai-command`); this token is
// confined to the call position, where `-` is never an operator.
// a provider action call. two-or-more dotted segments: the leading segments are the provider
// namespace path (`github`, or `github.repos`), the trailing segment is the function name.
action_stmt  = { action_ident ~ ("." ~ action_ident)+ ~ "(" ~ arg_list? ~ ")" }
action_ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }
arg_list     = { arg ~ ("," ~ arg)* ~ ","? }
arg          = { arg_spread | arg_pair }
// `...name` spreads a header alias's entries into this call; later args override earlier ones.
arg_spread   = { "..." ~ ident }
arg_pair     = { ident ~ ":" ~ expr }

mod_arg_list  = { mod_arg ~ ("," ~ mod_arg)* ~ ","? }
mod_arg       = { (ident ~ ":")? ~ expr }

subflow_stmt = { "subflow" ~ "(" ~ string ~ ("," ~ subflow_arg)* ~ ","? ~ ")" }
subflow_arg  = { ident ~ ":" ~ expr }

// `wait until <cond>` is a condition wait with no body: it parks, re-checks on the `every` interval
// (default 30s), and proceeds once the condition holds. sugar for `until <cond> { wait <interval> }`.
wait_cond_stmt = { "wait" ~ "until" ~ cond ~ wait_every? }
wait_every     = { "every" ~ duration }

wait_stmt   = { "wait" ~ wait_amount ~ wait_until? ~ wait_initial? }
// a literal duration (`30s`) or an expression yielding seconds (`params.poll.interval`).
wait_amount = { duration | expr }
wait_until  = { "until" ~ string }
wait_initial = { "initial" ~ string }

// the leading string is the event type; the trailing expression is the payload. an object
// payload keeps its brace form (`emit "x" { a: 1 }`); other payloads are any expression, and
// the decompiler parenthesizes an event-less scalar so it is not mistaken for the event type.
// shorthand for an output node with no artifact items; kept for backward compat.
emit_stmt = { "emit" ~ string? ~ expr? }

// block form merging event emission and artifact declarations into one output node.
// an optional `emit` sub-line declares the event; `name = expr` lines declare artifacts.
output_stmt   = { "output" ~ "{" ~ output_line* ~ "}" }
output_line   = _{ emit_stmt | artifact_line }
artifact_line = { ident ~ "=" ~ expr }

// supplies the value of an enclosing bound control region. lowers to a pure compute node.
yield_stmt = { "yield" ~ expr }

input_stmt = { "input" ~ expr? }

approval_stmt = { "approve" ~ expr ~ approval_type? ~ object? }
approval_type = { "type" ~ string }

// an automated/policy block. `kind` selects the resolver; `when` carries a condition gate's
// boolean; `every` tunes the poll interval; `timeout` sets the max-wait deadline; `on_timeout`
// chooses whether expiry fails or continues; the trailing object holds the label and extra metadata.
gate_stmt    = { "gate" ~ gate_kind ~ gate_when? ~ gate_every? ~ gate_timeout? ~ gate_timeout_policy? ~ object? }
gate_kind    = { "manual" | "condition" | "external" }
gate_when    = { "when" ~ cond }
gate_every   = { "every" ~ duration }
gate_timeout = { "timeout" ~ duration }
gate_timeout_policy = { "on_timeout" ~ gate_timeout_policy_value }
gate_timeout_policy_value = { "fail" | "continue" }

// pause until a named external signal is delivered to the run. the optional `key <expr>` binds a
// correlation value (e.g. a ticket key or PR number) so an inbound webhook can route to this parked
// run without knowing its run id. the trailing object holds optional metadata; the node timeout
// (via annotation) bounds the wait.
signal_stmt  = { "signal" ~ string ~ signal_key? ~ object? }
signal_key   = { "key" ~ expr }

// shared poll/timeout clauses for the coordination/resilience leaves below. `every` tunes the
// re-arm interval of a parking node; `timeout` bounds its total wait (carried on the node).
poll_every   = { "every" ~ duration }
node_timeout = { "timeout" ~ duration }

// inline invariant validation. each line names a boolean assertion; a run fails (listing every
// violation) when any condition is false. `assert { "amount_positive": context.amount > 0 }`.
assert_stmt  = { "assert" ~ "{" ~ assert_line* ~ "}" }
assert_line  = { string ~ ":" ~ cond ~ ","? }

// inline data reshape. each line binds a named context variable to an expression, surfaced
// downstream as the node output's `bindings`. `transform { total = sum(items) }`.
transform_stmt = { "transform" ~ "{" ~ transform_line* ~ "}" }
transform_line = { ident ~ "=" ~ expr ~ ","? }

// a compliance audit record. `action` is required; `actor`/`target`/`reason` are optional. each
// value is an expression resolved against context. `audit action "approved" actor context.user`.
audit_stmt   = { "audit" ~ audit_field+ }
audit_field  = { audit_kw ~ expr }
audit_kw     = { "action" | "actor" | "target" | "reason" }

// a named state snapshot for later rollback. `checkpoint "after-ingest"`.
checkpoint_stmt = { "checkpoint" ~ string }

// a named cross-run exclusive lock. `mutex "deploy" timeout 300s` acquires and holds until the run
// ends. `mutex "deploy" { ... }` brackets a critical section, releasing at the block's end. `hold`
// marks the maximum expected hold independently of the acquire-wait `timeout`; an overdue active
// holder remains exclusive and is never displaced. `mutex release "deploy"` is the bare release
// leaf a block desugars to. parks until the lease is free.
mutex_hold    = { "hold" ~ duration }
mutex_release = { "release" }
mutex_stmt    = { "mutex" ~ (mutex_release ~ string | string ~ poll_every? ~ node_timeout? ~ mutex_hold? ~ block?) }

// a named cross-run rate limiter (n per window). `throttle "github" rate 10 per 60s`.
throttle_stmt = { "throttle" ~ string ~ "rate" ~ integer ~ "per" ~ duration ~ poll_every? ~ node_timeout? }

// a named cross-run cooldown: at most one pass per window; passes inside the window short-circuit
// the run to success without running the body. `cooldown "sdlc-qa" every 900s`.
cooldown_stmt = { "cooldown" ~ string ~ poll_every }

// wait for run(s) of a named workflow to reach a terminal state. `key` narrows to runs carrying a
// matching correlation key; `mode` is `all` (default) or `any`.
// `await workflow "orders" key input.batch_id mode "all" timeout 1800s`.
await_stmt   = { "await" ~ (await_workflow | await_task) ~ await_key? ~ await_mode? ~ node_timeout? }
await_workflow = { "workflow" ~ string }
await_task = { ident }
await_key    = { "key" ~ expr }
await_mode   = { "mode" ~ string }

// a trailing-delay debounce. the window resets on each external reset call. `debounce "f" delay 30s`.
debounce_stmt = { "debounce" ~ string ~ "delay" ~ duration ~ debounce_key? }
debounce_key  = { "key" ~ expr }

// a timed accumulator. proceeds when the item count hits `max` or the timeout elapses.
// `collect "events" max 50 timeout 300s`.
collect_stmt = { "collect" ~ string ~ "max" ~ integer ~ node_timeout? }

// a multi-run rendezvous. proceeds once `count` runs have arrived. `barrier "sync" count 4`.
barrier_stmt = { "barrier" ~ string ~ "count" ~ integer ~ poll_every? ~ node_timeout? }

// a cross-run failure guard. when too many failures land in the window, the circuit trips and
// arrivals fast-fail until cooldown. `circuit_breaker "api" threshold 5 window 60s cooldown 120s`.
circuit_breaker_stmt = { "circuit_breaker" ~ string ~ "threshold" ~ integer ~ "window" ~ duration ~ "cooldown" ~ duration }

// stream-driven iteration. parks on an event subscription; each matching event drives one body
// iteration. `event_source type "file.uploaded" filter event.size > 1000 max 100 timeout 3600s`.
event_source_stmt = { "event_source" ~ "type" ~ string ~ event_filter? ~ event_max? ~ node_timeout? }
event_filter = { "filter" ~ cond }
event_max    = { "max" ~ integer }

config_stmt = { "set" ~ (config_name | config_meta) }
config_name = { "name" ~ "=" ~ expr }
config_meta = { "meta" ~ object }

// `return <expr>` is the concise successful terminal: it supplies the run's result and continues
// to the generated `end` node. `fail "<message>"` is its failing twin.
return_stmt = { return_kw ~ expr? }
return_kw   = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }

// `detach <handle>` discards an `async` task handle: the run stops tracking it and never joins it.
// It is the explicit opt-out that makes an unconsumed handle an error rather than a silent leak.
detach_stmt = { detach_kw ~ ident }
detach_kw   = @{ "detach" ~ !(ASCII_ALPHANUMERIC | "_") }

fail_stmt = { "fail" ~ expr? }

if_stmt    = { "if" ~ cond ~ block ~ else_if* ~ else_block? }
else_if    = { "else" ~ "if" ~ cond ~ block }
else_block = { "else" ~ block }

for_stmt   = { "for" ~ ident ~ (":" ~ type_expr)? ~ ("," ~ ident)? ~ "in" ~ expr ~ for_limit_expr? ~ block }
// `limit none` is the explicit form of an uncapped loop; `limit N` caps iterations.
// the for loop's cap may be any expression yielding an integer (evaluated at runtime),
// so `limit budget` works; `none` stays the explicit uncapped form.
for_limit_expr = { "limit" ~ (limit_none | expr) }
limit_none     = @{ "none" ~ !(ASCII_ALPHANUMERIC | "_") }
// while/until caps stay literal safety bounds.
for_limit  = { "limit" ~ (integer | limit_none) }

// condition-driven loops. `while c {}` repeats the body while c holds; `until c {}` is
// sugar for `while !c {}`. an optional `limit` caps iterations (a safety bound).
while_stmt = { "while" ~ cond ~ for_limit? ~ block }
until_stmt = { "until" ~ cond ~ for_limit? ~ block }

map_stmt        = { "map" ~ ident ~ "in" ~ expr ~ map_concurrency? ~ block }
// `concurrency none` is the explicit form of unbounded fan-out; `concurrency K` caps it.
map_concurrency = { "concurrency" ~ (integer | "none") }

match_stmt    = { "match" ~ expr ~ "{" ~ match_arm* ~ match_default? ~ "}" }
match_arm     = { !("else" ~ "->") ~ match_head ~ "->" ~ arm_body }
match_head    = { ("when" ~ cond) | expr }
match_default = { "else" ~ "->" ~ arm_body }
arm_body      = { block | stmt }

// a literal light switch: the subject's truthiness routes to the `on` or `off` arm.
toggle_stmt   = { "toggle" ~ expr ~ "{" ~ (toggle_on ~ toggle_off | toggle_off ~ toggle_on) ~ "}" }
toggle_on     = { "on" ~ "->" ~ arm_body }
toggle_off    = { "off" ~ "->" ~ arm_body }

// a weighted percentage split, hash-bucketed on the subject key; `else` names the default arm.
split_stmt    = { "split" ~ "on" ~ expr ~ "{" ~ split_arm+ ~ match_default? ~ "}" }
split_arm     = { integer ~ "%" ~ "->" ~ arm_body }

// ends an interrupt handler region and hands control back to the thread the interrupt suspended.
// the bare form resumes at the node the thread was on; `next` takes that node's success edge,
// `restart` re-enters it fresh, and `fail` settles it failed so the main flow's own `on_failure`
// edge decides what that means. legal only inside an `interrupt` block — a reachability property
// the grammar cannot express, so the reducer blocks it at runtime instead.
resume_stmt = { "resume" ~ resume_mode? }
resume_mode = { "next" | "restart" | "fail" }

try_stmt   = { "try" ~ block ~ try_catch? ~ try_finally? }
try_catch  = { "catch" ~ block }
try_finally = { "finally" ~ block }

parallel_stmt = { "parallel" ~ "{" ~ branch+ ~ "}" ~ join_clause? }
// note: a barrier clause always names a policy, so it can never be confused with a `join_decl`.
join_clause   = { join_kw ~ branch_selector? ~ branch_policy }
branch_selector = { "[" ~ (string ~ ("," ~ string)*)? ~ "]" }

race_stmt    = { "race" ~ winner_clause? ~ "{" ~ branch+ ~ "}" }
winner_clause = { "winner" ~ branch_policy }

branch        = { "branch" ~ string? ~ block }
branch_policy = { "all" | "any" | "first_success" }

block = { "{" ~ stmt* ~ "}" }

// transitions --------------------------------------------------------------

// every outgoing edge of a statement is gathered into one attached `routes { … }` section. each
// arm names an outcome (or a predicate) and hands control on with `continue <target>`.
transitions   = { routes_block }
routes_block  = { "routes" ~ "{" ~ route_arm+ ~ "}" }
route_arm     = { outcome_route | predicate_route }
outcome_route = { "on" ~ outcome ~ route_body }
// a user-defined predicate route: taken when `cond` holds. multiple predicate routes are tried in
// ascending `priority` (lower first); unset priorities keep declaration order.
predicate_route = { "when" ~ cond ~ edge_priority? ~ route_body }
route_body    = { "{" ~ continue_stmt ~ "}" }
continue_stmt = { "continue" ~ target }
edge_priority = { "priority" ~ integer }
// `next` names the happy-path edge for next-based leaves (wait/output/config) and control blocks;
// `success` is the happy path for on_success leaves.
outcome       = { "success" | "failure" | "timeout" | "reject" | "next" }
// `end` and `fail` are reserved references to the generated terminal nodes; every other target
// names a statement binding or a `join`.
target        = { "end" | "fail" | ident }

// conditions ---------------------------------------------------------------

cond         = { cond_or }
cond_or      = { cond_and ~ ("||" ~ cond_and)* }
cond_and     = { cond_unary ~ ("&&" ~ cond_unary)* }
cond_unary   = { not_cond | cond_primary }
not_cond     = { "!" ~ cond_unary }
cond_primary = { paren_cond | cond_exists | cond_cmp | expr }
paren_cond   = { "(" ~ cond ~ ")" }
cond_exists  = { "exists" ~ expr }
// operands are `coalesce_expr`, one level below `expr`, so an expression-level comparison can never
// shadow a condition comparison: `a == b` in a condition stays a `cond_cmp`, not an `expr` form.
cond_cmp     = { coalesce_expr ~ cmp_op ~ coalesce_expr }
cmp_op       = {
    "==" | "!=" | ">=" | "<=" | ">" | "<"
  | "contains" | "in" | "starts_with" | "ends_with"
}

// expressions --------------------------------------------------------------
//
// one expression grammar serves every position (action args, conditions, compute lines, string
// interpolation). arithmetic, library calls (`name(...)`), and lambdas all live here; purity
// analysis — not the grammar — decides whether an expression folds eagerly in the reducer or must
// sit inside a `compute` block. an effectful call outside compute is a semantic error.

// a lambda (`x => expr` or `(a, b) => expr`) binds loosest and is passed to higher-order library
// calls like `map`/`filter`/`reduce`. it is tried first and backtracks when no `=>` follows.
expr          = { lambda | ternary_expr }
lambda        = { lambda_params ~ "=>" ~ expr }
lambda_params = { ("(" ~ (ident ~ ("," ~ ident)*)? ~ ")") | ident }
// a lazy conditional `cond ? a : b`, binding loosest below lambda; the branches are full
// expressions so ternaries nest right-associatively. lowers to the runtime `$if` form.
ternary_expr  = { cast_expr ~ ("?" ~ expr ~ ":" ~ expr)? }
// an `expr as Type` cast, binding just below the ternary: an author-time type assertion that is
// erased at lowering. `as` is only a cast token here; it never conflicts with the `import ... as`
// header form. the target is a full `type_expr`, so `x as int | string` casts to the union.
cast_expr     = { compare_expr ~ ("as" ~ type_expr)? }
// a single, non-associative relational comparison binding looser than coalesce; `>=`/`<=` precede
// `>`/`<` so the two-char forms win. each lowers to the matching pure intrinsic (`eq`/`lt`/...).
compare_expr  = { coalesce_expr ~ (compare_op ~ coalesce_expr)? }
compare_op    = { "==" | "!=" | ">=" | "<=" | ">" | "<" }
coalesce_expr = { concat_expr ~ ("??" ~ concat_expr)* }
concat_expr   = { sum_expr ~ ("++" ~ sum_expr)* }
sum_expr      = { term_expr ~ (add_op ~ term_expr)* }
term_expr     = { unary_expr ~ (mul_op ~ unary_expr)* }
unary_expr    = { neg_expr | postfix_expr }
neg_expr      = { "-" ~ unary_expr }

// a primary followed by zero or more accesses, binding tighter than any operator. three forms:
//   - `.method(args)` — fluent/ufcs method call: `recv.f(a)` desugars to `f(recv, a)`, so a chain
//     like `xs.filter(p).map(g)` reads left-to-right (every stdlib intrinsic takes its subject first).
//   - `.key` — field access. on a path it folds into the path (one `$ref`); on any other value it
//     lowers to the `at` intrinsic.
//   - `[expr]` — index access (same fold/`at` rule). the key may be dynamic (`items[params.i]`).
//   - `(args)` — apply-access: applies the preceding value as a first-class function/closure. it
//     is how a field- or index-held closure is called: `(obj.f)(x)`, `fns[0](x)`. a bare `name(x)`
//     is still a `lib_call` primary, so this only kicks in after a parenthesized/indexed/field value.
postfix_expr  = { primary ~ access* }
access        = { ("." ~ ident ~ "(" ~ (call_arg ~ ("," ~ call_arg)*)? ~ ")" ~ call_policy?) | ("." ~ path_seg) | ("[" ~ expr ~ "]") | apply_access }
apply_access  = { "(" ~ (call_arg ~ ("," ~ call_arg)*)? ~ ")" }

// per-call overrides for the enclosing node's policy, e.g.
// `github.deploy(ref: "main") with { timeout: 30s, retry: { max_attempts: 3 } }`.
//
// this attaches to *call syntax only*, never to an arbitrary expression. `with` already introduces
// an object in three statement positions (`trigger cron <expr> with { … }`, `trigger on_success
// workflow <expr> with { … }`, and `notify … with { … }`), and an expression-level postfix would
// greedily swallow those — a cron trigger's options would silently become a policy on its schedule
// string. requiring a preceding call is what keeps the two unambiguous.
call_policy   = { "with" ~ object }

primary = {
    paren_expr
  | file_call
  | dir_call
  | inline_call
  | func_call
  | lib_call
  | object
  | array
  | duration
  | number
  | boolean
  | null_lit
  | string
  | path
}

paren_expr = { "(" ~ expr ~ ")" }
file_call  = { "file" ~ "(" ~ string ~ ")" }
// directory listing: `dir(path)` lists the top level; an optional boolean recurses, an optional
// trailing integer caps the recursion depth.
dir_call   = { "dir" ~ "(" ~ string ~ ("," ~ boolean ~ ("," ~ number)?)? ~ ")" }
inline_call = { "inline" ~ "(" ~ string ~ "," ~ raw_block ~ ")" }
// `string`/`json` are the coercion calls; every other `name(...)` is a library call.
func_call  = { func_name ~ "(" ~ expr ~ ")" }
func_name  = { "string" | "json" }
// call arguments are positional expressions or trailing `name: value` keyword args. `named_arg`
// is tried first; a bare positional expression (even a path or ternary) backtracks cleanly.
lib_call   = { !(func_name ~ "(") ~ ident ~ "(" ~ (call_arg ~ ("," ~ call_arg)*)? ~ ")" ~ call_policy? }
call_arg   = { named_arg | expr }
named_arg  = { ident ~ ":" ~ expr }

// a dotted reference path. a segment that is an identifier immediately followed by `(` is NOT
// consumed here — it is a fluent method call (`recv.f(...)`) handled by `access`, not a path field.
path     = ${ ident ~ ("." ~ !(ident ~ "(") ~ path_seg)* }
path_seg = { ident | integer }

object        = { "{" ~ (object_entry ~ ("," ~ object_entry)*)? ~ ","? ~ "}" }
object_entry  = { object_spread | object_pair | object_shorthand }
// `...name` spreads a header alias's entries into this object; later entries override earlier ones.
object_spread = { "..." ~ ident }
object_pair   = { (ident | string) ~ ":" ~ expr }
object_shorthand = { ident }

array = { "[" ~ (expr ~ ("," ~ expr)*)? ~ ","? ~ "]" }

duration = @{ ASCII_DIGIT+ ~ ("s" | "m" | "h" | "d") }
number   = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
integer  = @{ "-"? ~ ASCII_DIGIT+ }
boolean  = { "true" | "false" }
null_lit = { "null" }

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// string literals with ${...} interpolation. compound-atomic so inner text keeps its
// bytes; interpolation re-enables whitespace for the embedded expression.
string        = ${ "\"" ~ str_part* ~ "\"" }
str_part      = { interpolation | escape | str_text }
interpolation = !{ "${" ~ expr ~ "}" }
escape        = @{ "\\" ~ ANY }
str_text      = @{ (!("\"" | "\\" | "${") ~ ANY)+ }
raw_block     = ${ "```" ~ (!"```" ~ ANY)* ~ "```" }
