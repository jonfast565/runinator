language rexrap-1

namespace runinator.sdlc {

workflow "SDLC: Deploy" v1 {
    key deploy

    // scan Ready for Testing tickets (merged, awaiting deploy). each pass classifies the merged diff
    // by path, dispatches the matching deploy workflows, verifies none failed, then moves the ticket
    // to In Testing (the QA phase's inbox). the status transition is the deploy marker: a ticket in
    // In Testing has already been dispatched, so it is never double-deployed.
    trigger cron "*/30 * * * *"

    import std
    import settings jira as jira
    import settings github as gh
    import settings selection as selection
    import settings git as git_cfg
    import settings branch as branch
    import settings deploy as deploy
    import settings waits as waits
    import settings transitions as transitions

    alias jira_conn = { base_url: jira.base_url, email: jira.email, token: jira.secret.token }
    alias gh_conn = { token: gh.secret.token, owner: gh.owner, repo: gh.repo }

    do {
        // cooldown: collapse a near-simultaneous cron + chained fire into one pass per 5 minutes so a
        // burst never re-scans the inbox back-to-back. cron still drives the baseline cadence, and a
        // chained fire that lands after the window still runs.
        cooldown "sdlc-deploy" every 300s

        mutex "sdlc-deploy" every 10s timeout 1800s

        set name = "SDLC Deploy scan"

        @timeout(120s)
        @retry(4, backoff: 5s, max: 60s, jitter: true, on: any)
        let tickets = jira.search(...jira_conn, jql: jira.deploy_jql)

        for ticket in tickets.issues limit selection.max_in_flight {
            @runner("sdlc")
            @timeout(120s)
            @retry(2, backoff: 5s, max: 30s, jitter: true, on: failure)
            let workspace = git.worktree(
                repo: git_cfg.repo,
                branch: branch.prefix ++ ticket.key,
                path: git_cfg.worktree_root ++ "/" ++ ticket.key
            )

            @runner("sdlc")
            @timeout(60s)
            @retry(4, backoff: 5s, max: 60s, jitter: true, on: any)
            let merged_diff = git.diff(workspace: workspace.workspace)

            let impact: { api: boolean, dashboards: boolean, lambdas: string[] } = compute {
                let files = split(merged_diff.stdout, "\n")
                return {
                    api: any(files, f => f.starts_with(deploy.api_prefix)),
                    dashboards: any(files, f => f.starts_with(deploy.dashboard_prefix)),
                    lambdas: filter(files, f => f.starts_with(deploy.lambda_prefix))
                }
            }

            parallel {
                branch {
                    if impact.api {
                        @timeout(60s)
                        let deploy_api = github.dispatch(
                            ...gh_conn,
                            workflow_id: deploy.api_workflow,
                            ref: gh.base_branch
                        )
                    }
                }
                branch {
                    if impact.dashboards {
                        @timeout(60s)
                        let deploy_dash = github.dispatch(
                            ...gh_conn,
                            workflow_id: deploy.dashboard_workflow,
                            ref: gh.base_branch
                        )
                    }
                }
                branch {
                    for lambda_path in impact.lambdas limit none {
                        @timeout(60s)
                        let deploy_lambda = github.dispatch(
                            ...gh_conn,
                            workflow_id: deploy.lambda_workflow,
                            ref: gh.base_branch,
                            inputs: { path: lambda_path }
                        )
                    }
                }
            } join all

            // let the dispatched runs start, then confirm none failed before handing off to QA.
            wait waits.deploy_settle_seconds

            @timeout(30s)
            @retry(4, backoff: 5s, max: 60s, jitter: true, on: any)
            let deploy_runs: any = github.workflow_runs(
                ...gh_conn,
                branch: gh.base_branch
            )
            let deploy_state: { failed: integer } = compute {
                let runs = deploy_runs.workflow_runs
                return { failed: len(filter(runs, r => r.conclusion == "failure")) }
            }

            // only advance a clean deploy; a failed deploy leaves the ticket in Ready for Testing with a
            // note so the next pass retries.
            if deploy_state.failed > 0 {
                @timeout(30s)
                let deploy_failed_note = jira.comment(
                    ...jira_conn,
                    key: ticket.key,
                    body: "A deployment workflow failed for " ++ ticket.key ++ "; leaving in Ready for Testing to retry."
                )
            }
            if eq(deploy_state.failed, 0) {
                @timeout(30s)
                let transition_testing = jira.transition(
                    ...jira_conn,
                    key: ticket.key,
                    transition_id: transitions.in_testing
                )
                @timeout(30s)
                let deployed_note = jira.comment(
                    ...jira_conn,
                    key: ticket.key,
                    body: "Deployed " ++ ticket.key ++ "; moving to In Testing for QA."
                )
            }
        }
    }
}
}
