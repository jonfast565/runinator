language rexrap-1

namespace runinator.sdlc {

workflow "SDLC: Review" v1 {
    key review

    // scan In Review tickets the automation owns. each pass re-attaches the worktree, has claude
    // address open Copilot/human feedback, checks CI and approvals, and merges when ready — moving
    // the ticket to Ready for Testing (the Deploy phase's inbox). tickets not yet ready are left in
    // In Review for the next pass.
    trigger cron "*/30 * * * *"

    import std
    import settings jira as jira
    import settings github as github_settings
    import settings slack as slack
    import settings claude as claude
    import settings selection as selection
    import settings review as review_settings
    import settings branch as branch
    import settings git as git_settings
    import settings transitions as transitions

    alias jira_conn = { base_url: jira.base_url, email: jira.email, token: jira.secret.token }
    alias github_conn = { token: github_settings.secret.token, owner: github_settings.owner, repo: github_settings.repo }
    alias slack_conn = { token: slack.secret.token, channel: slack.channel }
    alias claude_cfg = {
        binary: claude.binary,
        model: claude.model,
        output_format: claude.output_format,
        allowed_tools: claude.allowed_tools,
        permission_mode: claude.permission_mode,
        extra_args: claude.extra_args
    }

    do {
        // cooldown: collapse a near-simultaneous cron + chained fire into one pass per 5 minutes so a
        // burst never re-scans the inbox back-to-back. cron still drives the baseline cadence, and a
        // chained fire that lands after the window still runs.
        cooldown "sdlc-review" every 300s

        mutex "sdlc-review" every 10s timeout 1800s

        set name = "SDLC Review scan"

        @timeout(120s)
        @retry(4, backoff: 5s, max: 60s, jitter: true, on: any)
        let tickets = jira.search(...jira_conn, jql: jira.in_review_jql)

        for ticket in tickets.issues limit selection.max_in_flight {
            // re-attach the shared worktree on the sdlc worker (create-or-attach from the remote branch).
            @runner("sdlc")
            @timeout(120s)
            @retry(2, backoff: 5s, max: 30s, jitter: true, on: failure)
            let workspace = git.worktree(
                repo: git_settings.repo,
                branch: branch.prefix ++ ticket.key,
                path: git_settings.worktree_root ++ "/" ++ ticket.key
            )

            // create-or-update returns the existing open PR for this branch (no duplicate is opened).
            @timeout(60s)
            let pr = github.create_pr(
                ...github_conn,
                base: github_settings.base_branch,
                head: branch.prefix ++ ticket.key,
                title: ticket.key ++ ": " ++ ticket.fields.summary,
                body: "Automated implementation for " ++ ticket.key ++ "."
            )

            @timeout(30s)
            let add_reviewers = github.request_reviewers(
                ...github_conn,
                pull_number: string(pr.number),
                reviewers: review_settings.reviewers
            )
            @timeout(30s)
            let add_assignee = github.add_assignees(
                ...github_conn,
                issue_number: string(pr.number),
                assignees: review_settings.assignees
            )

            // one claude pass addresses whatever Copilot/review feedback is open on the PR; commit and
            // push any resulting changes so CI re-runs before the approval check below.
            @runner("sdlc")
            @timeout(1800s)
            let fix_feedback = ai-command.claude_code(
                ...claude_cfg,
                working_dir: workspace.workspace,
                prompt: claude.review_fix_prompt
                    ++ " PR #" ++ string(pr.number)
                    ++ " in " ++ github_settings.owner ++ "/" ++ github_settings.repo
            )
            @runner("sdlc")
            @timeout(30s)
            @retry(4, backoff: 5s, max: 60s, jitter: true, on: any)
            let fix_diff = git.diff(workspace: workspace.workspace)
            if fix_diff.stdout.trim().len() > 0 {
                @runner("sdlc")
                @timeout(60s)
                let commit_fix = git.commit(
                    workspace: workspace.workspace,
                    message: ticket.key ++ " address review feedback"
                )
                @runner("sdlc")
                @timeout(60s)
                @retry(3, backoff: 5s, max: 45s, jitter: true, on: failure)
                let push_fix = git.push(
                    workspace: workspace.workspace,
                    remote: git_settings.remote,
                    branch: branch.prefix ++ ticket.key
                )
            }

            // gate a merge on green CI and enough approvals: two approvals, or one with no outstanding
            // change requests. anything short leaves the ticket In Review for the next pass.
            @timeout(30s)
            @retry(4, backoff: 5s, max: 60s, jitter: true, on: any)
            let ci = github.checks_summary(...github_conn, ref: pr.head.sha)
            @timeout(30s)
            @retry(4, backoff: 5s, max: 60s, jitter: true, on: any)
            let reviews: any = github.reviews(...github_conn, pull_number: string(pr.number))
            let review_state: { approved: integer, changes_requested: integer, two_plus: boolean, ready: boolean } = compute {
                let approved = len(filter(reviews, r => r.state == "APPROVED"))
                let changes = len(filter(reviews, r => r.state == "CHANGES_REQUESTED"))
                return {
                    approved: approved,
                    changes_requested: changes,
                    two_plus: gte(approved, 2),
                    ready: or(gte(approved, 2), and(gte(approved, 1), eq(changes, 0)))
                }
            }

            if and(ci.status == "passed", review_state.ready) {
                @timeout(60s)
                let merge_pr = github.merge_pr(
                    ...github_conn,
                    pull_number: string(pr.number),
                    merge_method: "squash"
                )
                @timeout(30s)
                let transition_testing = jira.transition(
                    ...jira_conn,
                    key: ticket.key,
                    transition_id: transitions.ready_for_testing
                )
                @timeout(30s)
                let ready_comment = jira.comment(
                    ...jira_conn,
                    key: ticket.key,
                    body: "Merged " ++ pr.html_url ++ "; moving to Ready for Testing."
                )
                @timeout(15s)
                @retry(3, backoff: 5s, max: 45s, jitter: true, on: failure)
                let notify_merged = slack.send_message(
                    ...slack_conn,
                    text: ":twisted_rightwards_arrows: " ++ ticket.key ++ " merged and ready to deploy."
                )
            }
        }
    }
}
}
