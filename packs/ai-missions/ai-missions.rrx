language rexrap-1

package {
  {
    "item_type": "rexrap_pack",
    "name": "Bounded Claude Code Missions",
    "version": 1
  }
}

namespace runinator.missions {

workflow "Implement Coding Mission" v1 {
    params {
        request: any
        mission: any
        orchestration: any
    }
    key coding_implement

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(7200s)
        let implementation = ai-command.claude_code(
            prompt: "You are the implementation agent for coding mission: ${params.request.goal}. Work only in the assigned workspace. Read repository guidance before editing. Implement the smallest complete solution, run relevant checks, and leave all changes uncommitted for review. Do not commit, push, open a pull request, deploy, change credentials, or start another mission. Report the work, checks, and remaining risks in the final response.",
            harnessed: true,
            role: "implementer",
            resume_session: params.orchestration.resources.coding.implementation_session,
            mcp_config: params.mission.mcp_config,
            max_turns: 8,
            permission_mode: "acceptEdits",
            allowed_tools: "Read,Write,Edit,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(cargo test:*),Bash(cargo check:*),Bash(cargo fmt:*),Bash(pnpm test:*),Bash(pnpm build:*),Bash(npm test:*),Bash(npm run build:*),Bash(rg:*)"
        )

        compute {
            return {
                resources_patch: {
                    coding: {
                        implementation_session: implementation.response.session_id,
                        latest_implementation: implementation.response.result
                    }
                },
                evidence: {
                    role: "implementer",
                    response: implementation.response
                },
                next_member: "runinator.missions.coding.review"
            }
        }
    }
}

workflow "Review Coding Mission" v1 {
    params {
        request: any
        mission: any
        orchestration: any
    }
    key coding_review

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(3600s)
        let review = ai-command.claude_code(
            prompt: "You are the independent reviewer for coding mission: ${params.request.goal}. Inspect the assigned workspace and the current diff. Do not edit files. Assess correctness, scope, tests, and regressions. Reply with only JSON in this exact shape: {\"next_member\":\"runinator.missions.coding.verify\"|\"runinator.missions.coding.implement\",\"summary\":\"short review summary\",\"findings\":[\"...\"]}. Route to implement only for a concrete repair; otherwise route to verify. Never commit, push, deploy, use credentials, or start another mission.",
            harnessed: true,
            role: "reviewer",
            mcp_config: params.mission.mcp_config,
            max_turns: 4,
            permission_mode: "plan",
            allowed_tools: "Read,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(cargo test:*),Bash(cargo check:*),Bash(pnpm test:*),Bash(pnpm build:*),Bash(npm test:*),Bash(npm run build:*),Bash(rg:*)"
        )

        compute {
            let decision: { next_member: string, summary: string, findings: string[] } = std.encoding.parse_json(review.response.result)
            return {
                resources_patch: { coding: { latest_review: decision } },
                evidence: { role: "reviewer", review: decision },
                next_member: decision.next_member
            }
        }
    }
}

workflow "Verify Coding Mission" v1 {
    params {
        request: any
        mission: any
        orchestration: any
    }
    key coding_verify

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(3600s)
        let verification = ai-command.claude_code(
            prompt: "You are the verification agent for coding mission: ${params.request.goal}. Work only in the assigned workspace. Do not edit files. Run the narrowest relevant checks and inspect the current diff. Reply with only JSON in this exact shape: {\"next_member\":\"runinator.missions.coding.implement\"|\"runinator.missions.coding.summary\",\"summary\":\"short verification summary\",\"checks\":[\"...\"],\"failures\":[\"...\"]}. Route to implement only when there is a specific repairable failure; otherwise route to summary. Never commit, push, deploy, use credentials, or start another mission.",
            harnessed: true,
            role: "verifier",
            mcp_config: params.mission.mcp_config,
            max_turns: 4,
            permission_mode: "plan",
            allowed_tools: "Read,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(cargo test:*),Bash(cargo check:*),Bash(cargo fmt:*),Bash(pnpm test:*),Bash(pnpm build:*),Bash(npm test:*),Bash(npm run build:*),Bash(rg:*)"
        )

        compute {
            let decision: { next_member: string, summary: string, checks: string[], failures: string[] } = std.encoding.parse_json(verification.response.result)
            return {
                resources_patch: { coding: { latest_verification: decision } },
                evidence: { role: "verifier", verification: decision },
                next_member: decision.next_member
            }
        }
    }
}

workflow "Summarize Coding Mission" v1 {
    params {
        request: any
        mission: any
        orchestration: any
    }
    key coding_summary

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(1800s)
        let summary = ai-command.claude_code(
            prompt: "Summarize coding mission: ${params.request.goal}. Use the assigned workspace and recorded work to give a concise handoff: changes made, verification performed, review outcome, and remaining risks. Do not edit files. Do not commit, push, deploy, use credentials, or start another mission.",
            harnessed: true,
            role: "reporter",
            mcp_config: params.mission.mcp_config,
            max_turns: 3,
            permission_mode: "plan",
            allowed_tools: "Read,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(rg:*)"
        )

        compute {
            return {
                resources_patch: { coding: { final_summary: summary.response.result } },
                evidence: { role: "reporter", summary: summary.response }
            }
        }
    }
}

workflow "Investigate Research Mission" v1 {
    params {
        request: any
        mission: any
        orchestration: any
    }
    key research_investigate

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(5400s)
        let investigation = ai-command.claude_code(
            prompt: "You are the investigator for research/report mission: ${params.request.goal}. Work only in the assigned workspace. Gather relevant local evidence, inspect the codebase or artifacts, and write a structured research note in your final response with claims, evidence, unknowns, and suggested next questions. Do not modify files unless the request explicitly requires a report artifact. Do not commit, push, deploy, use credentials, or start another mission.",
            harnessed: true,
            role: "investigator",
            resume_session: params.orchestration.resources.research.investigator_session,
            mcp_config: params.mission.mcp_config,
            max_turns: 7,
            permission_mode: "plan",
            allowed_tools: "Read,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(rg:*),Bash(cargo test:*),Bash(cargo check:*),Bash(pnpm test:*),Bash(pnpm build:*),Bash(npm test:*),Bash(npm run build:*)"
        )

        compute {
            return {
                resources_patch: {
                    research: {
                        investigator_session: investigation.response.session_id,
                        latest_investigation: investigation.response.result
                    }
                },
                evidence: { role: "investigator", response: investigation.response },
                next_member: "runinator.missions.research.critique"
            }
        }
    }
}

workflow "Critique Research Mission" v1 {
    params {
        request: any
        mission: any
        orchestration: any
    }
    key research_critique

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(2700s)
        let critique = ai-command.claude_code(
            prompt: "You are the independent critic for research/report mission: ${params.request.goal}. Inspect the assigned workspace and research evidence. Do not edit files. Reply with only JSON in this exact shape: {\"next_member\":\"runinator.missions.research.investigate\"|\"runinator.missions.research.report\",\"summary\":\"short critique summary\",\"gaps\":[\"...\"],\"confidence\":\"low|medium|high\"}. Route to investigate only for a material evidence gap; otherwise route to report. Never commit, push, deploy, use credentials, or start another mission.",
            harnessed: true,
            role: "research_critic",
            mcp_config: params.mission.mcp_config,
            max_turns: 4,
            permission_mode: "plan",
            allowed_tools: "Read,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(rg:*)"
        )

        compute {
            let decision: { next_member: string, summary: string, gaps: string[], confidence: string } = std.encoding.parse_json(critique.response.result)
            return {
                resources_patch: { research: { latest_critique: decision } },
                evidence: { role: "research_critic", critique: decision },
                next_member: decision.next_member
            }
        }
    }
}

workflow "Report Research Mission" v1 {
    params {
        request: any
        mission: any
        orchestration: any
    }
    key research_report

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(3600s)
        let report = ai-command.claude_code(
            prompt: "Produce the final research/report deliverable for: ${params.request.goal}. Use the assigned workspace and the prior investigation context. State the answer first, distinguish observed facts from inference, cite local file paths or command evidence where available, enumerate unresolved questions, and give practical next steps. Do not commit, push, deploy, use credentials, or start another mission.",
            harnessed: true,
            role: "research_reporter",
            resume_session: params.orchestration.resources.research.investigator_session,
            mcp_config: params.mission.mcp_config,
            max_turns: 5,
            permission_mode: "plan",
            allowed_tools: "Read,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(rg:*),Bash(cargo test:*),Bash(cargo check:*),Bash(pnpm test:*),Bash(pnpm build:*),Bash(npm test:*),Bash(npm run build:*)"
        )

        compute {
            return {
                resources_patch: { research: { final_report: report.response.result } },
                evidence: { role: "research_reporter", report: report.response }
            }
        }
    }
}

}

pipeline "Bounded Coding Mission" {
    key coding_mission
    namespace runinator.missions
    description "A bounded implement-review-verify loop with a durable Claude Code session."

    ingress scope "mission.coding" {
        on "start" when unbound -> start
        on "cancel" when active -> dispatch "cancel"
        on "pause" when active -> dispatch "pause"
        on "resume" when active -> dispatch "resume"
        on "requeue" when terminal -> requeue
    }

    orchestration {
        entry "runinator.missions.coding.implement"
        max_epochs 10
        intent "cancel" effect terminate priority 100
        intent "pause" effect suspend priority 80 stop pause restart current
        intent "resume" effect resume priority 70 restart current

        phase "runinator.missions.coding.implement" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.coding.review" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.coding.verify" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.coding.summary" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
    }

    workflow "runinator.missions.coding.implement"
    workflow "runinator.missions.coding.review"
    workflow "runinator.missions.coding.verify"
    workflow "runinator.missions.coding.summary"
}

pipeline "Bounded Research and Report Mission" {
    key research_report_mission
    namespace runinator.missions
    description "A bounded investigate-critique-report loop with a durable Claude Code session."

    ingress scope "mission.research_report" {
        on "start" when unbound -> start
        on "cancel" when active -> dispatch "cancel"
        on "pause" when active -> dispatch "pause"
        on "resume" when active -> dispatch "resume"
        on "requeue" when terminal -> requeue
    }

    orchestration {
        entry "runinator.missions.research.investigate"
        max_epochs 8
        intent "cancel" effect terminate priority 100
        intent "pause" effect suspend priority 80 stop pause restart current
        intent "resume" effect resume priority 70 restart current

        phase "runinator.missions.research.investigate" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.research.critique" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.research.report" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
    }

    workflow "runinator.missions.research.investigate"
    workflow "runinator.missions.research.critique"
    workflow "runinator.missions.research.report"
}
