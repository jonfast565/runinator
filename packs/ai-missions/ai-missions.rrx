language rexrap-1

package {
  {
    "item_type": "rexrap_pack",
    "name": "Bounded Claude Code Missions",
    "version": 1
  }
}

namespace runinator.missions {

workflow "Prepare Coding Mission Source" v1 {
    params {
        request: { goal: string }
        mission: { kind: string, correlation_key: string, requested_by: string, source: { repository: string, revision: string } }
        orchestration: { binding_id: string, workspace_affinity: any, resources: any }
    }
    key coding_prepare

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(900s)
        let prepare_source = git.prepare_checkout(
            repository: params.mission.source.repository,
            revision: params.mission.source.revision
        )

        compute {
            return {
                resources_patch: { coding: { source: prepare_source } },
                evidence: { role: "source", source: prepare_source },
                next_member: "runinator.missions.coding_implement"
            }
        }
    }
}

workflow "Implement Coding Mission" v1 {
    params {
        request: { goal: string }
        mission: { kind: string, correlation_key: string, requested_by: string, source: { repository: string, revision: string } }
        orchestration: { binding_id: string, workspace_affinity: any, resources: any }
    }
    key coding_implement
    import settings prompts as prompt_settings

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(7200s)
        @profile("claude")
        let implementation = ai-command.claude_code(
            prompt: file("prompts/coding-implement.md"),
            prompt_asset: "coding-implement",
            prompt_override: prompt_settings.config.coding_implement,
            prompt_context: "Goal: " ++ params.request.goal ++ "\nMission binding: " ++ params.orchestration.binding_id ++ "\nPinned source commit: " ++ string(params.orchestration.resources.coding.source.sha),
            harnessed: true,
            role: "implementer",
            resume_session: string(params.orchestration.resources.coding.implementation_session ?? ""),
            mission_mcp: true,
            mission_id: params.orchestration.binding_id,
            max_turns: 8,
            permission_mode: "dontAsk",
            allowed_tools: "Read,Write,Edit,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(cargo test:*),Bash(cargo check:*),Bash(cargo fmt:*),Bash(pnpm test:*),Bash(pnpm build:*),Bash(npm test:*),Bash(npm run build:*),Bash(rg:*),mcp__runinator-mission__runinator_missions_show,mcp__runinator-mission__runinator_missions_evidence,mcp__runinator-mission__runinator_missions_intent"
        )

        compute {
            return {
                resources_patch: {
                    coding: {
                        implementation_session: implementation.response.session_id,
                        latest_implementation: implementation.response.result
                    }
                },
                evidence: {
                    role: "implementer",
                    response: implementation.response,
                    prompt: implementation.prompt
                },
                next_member: "runinator.missions.coding_review"
            }
        }
    }
}

workflow "Review Coding Mission" v1 {
    params {
        request: { goal: string }
        mission: { kind: string, correlation_key: string, requested_by: string, source: { repository: string, revision: string } }
        orchestration: { binding_id: string, workspace_affinity: any, resources: any }
    }
    key coding_review
    import settings prompts as prompt_settings

    do {
        @workspace(params.orchestration.workspace_affinity)
        @timeout(3600s)
        @profile("claude")
        let review = ai-command.claude_code(
            prompt: file("prompts/coding-review.md"),
            prompt_asset: "coding-review",
            prompt_override: prompt_settings.config.coding_review,
            prompt_context: "Goal: " ++ params.request.goal ++ "\nMission binding: " ++ params.orchestration.binding_id,
            harnessed: true,
            role: "reviewer",
            mission_mcp: true,
            mission_id: params.orchestration.binding_id,
            max_turns: 4,
            permission_mode: "dontAsk",
            output_schema: { type: "object", properties: { next_member: { type: "string", enum: ["runinator.missions.coding_verify", "runinator.missions.coding_implement"] }, summary: { type: "string" }, findings: { type: "array", items: { type: "string" } } }, required: ["next_member", "summary", "findings"] },
            allowed_tools: "Read,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(cargo test:*),Bash(cargo check:*),Bash(pnpm test:*),Bash(pnpm build:*),Bash(npm test:*),Bash(npm run build:*),Bash(rg:*),mcp__runinator-mission__runinator_missions_show,mcp__runinator-mission__runinator_missions_evidence,mcp__runinator-mission__runinator_missions_intent"
        )

        compute {
            let decision: { next_member: string, summary: string, findings: string[] } = review.response.structured_output
            return {
                resources_patch: { coding: { latest_review: decision } },
                evidence: { role: "reviewer", review: decision, prompt: review.prompt },
                next_member: decision.next_member
            }
        }
    }
}

