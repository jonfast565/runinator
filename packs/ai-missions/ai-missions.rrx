pipeline "Bounded Coding Mission" {
    key coding_mission
    namespace runinator.missions
    description "A bounded implement-review-verify loop with a durable Claude Code session."

    ingress scope "mission.coding" {
        on "start" when unbound -> start
        on "cancel" when active -> dispatch "cancel"
        on "pause" when active -> dispatch "pause"
        on "resume" when active -> dispatch "resume"
        on "requeue" when terminal -> requeue
    }

    orchestration {
        entry "runinator.missions.coding_prepare"
        max_epochs 10
        intent "cancel" effect terminate priority 100
        intent "pause" effect suspend priority 80 stop pause restart current
        intent "resume" effect resume priority 70 restart current

        phase "runinator.missions.coding_prepare" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.coding_implement" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.coding_review" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.coding_verify" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.coding_summary" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
    }

    workflow "runinator.missions.coding_prepare"
    workflow "runinator.missions.coding_implement"
    workflow "runinator.missions.coding_review"
    workflow "runinator.missions.coding_verify"
    workflow "runinator.missions.coding_summary"
}

pipeline "Bounded Research and Report Mission" {
    key research_report_mission
    namespace runinator.missions
    description "A bounded investigate-critique-report loop with a durable Claude Code session."

    ingress scope "mission.research_report" {
        on "start" when unbound -> start
        on "cancel" when active -> dispatch "cancel"
        on "pause" when active -> dispatch "pause"
        on "resume" when active -> dispatch "resume"
        on "requeue" when terminal -> requeue
    }

    orchestration {
        entry "runinator.missions.research_prepare"
        max_epochs 8
        intent "cancel" effect terminate priority 100
        intent "pause" effect suspend priority 80 stop pause restart current
        intent "resume" effect resume priority 70 restart current

        phase "runinator.missions.research_prepare" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.research_investigate" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.research_critique" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            next_member from "/next_member"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
        phase "runinator.missions.research_report" {
            resources_patch from "/resources_patch"
            evidence from "/evidence"
            workspace scope "mission-source" reuse lease 2h recovery wait labels { "capability": "git" }
        }
    }

    workflow "runinator.missions.research_prepare"
    workflow "runinator.missions.research_investigate"
    workflow "runinator.missions.research_critique"
    workflow "runinator.missions.research_report"
}

tests {
  {
    "tests": [
      {
        "name": "pins the source before entering the implementation loop",
        "workflow": "Prepare Coding Mission Source",
        "input": {
          "request": { "goal": "implement a bounded change" },
          "mission": { "kind": "coding", "correlation_key": "coding-test", "requested_by": "test", "source": { "repository": "https://example.invalid/repo.git", "revision": "abc123" } },
          "orchestration": { "binding_id": "018f5f7c-4b74-7f44-8fd1-cde6b5c4d111", "workspace_affinity": {}, "resources": {} }
        },
        "mocks": {
          "prepare_source": { "output": { "repository": "https://example.invalid/repo.git", "revision": "abc123", "sha": "abc123", "workspace": "/workspace" } }
        },
        "expect": { "status": "succeeded", "reached": ["prepare_source"] }
      },
      {
        "name": "parses a declared review route",
        "workflow": "Review Coding Mission",
        "input": {
          "request": { "goal": "review a bounded change" },
          "mission": { "kind": "coding", "correlation_key": "review-test", "requested_by": "test", "source": { "repository": "https://example.invalid/repo.git", "revision": "abc123" } },
          "orchestration": { "binding_id": "018f5f7c-4b74-7f44-8fd1-cde6b5c4d111", "workspace_affinity": {}, "resources": {} }
        },
        "mocks": { "review": { "output": { "response": { "result": "{\"next_member\":\"runinator.missions.coding_verify\",\"summary\":\"ready\",\"findings\":[]}" } } } },
        "expect": { "status": "succeeded" }
      },
      {
        "name": "pins the source before entering the research loop",
        "workflow": "Prepare Research Mission Source",
        "input": {
          "request": { "goal": "research the implementation" },
          "mission": { "kind": "research_report", "correlation_key": "research-test", "requested_by": "test", "source": { "repository": "https://example.invalid/repo.git", "revision": "abc123" } },
          "orchestration": { "binding_id": "018f5f7c-4b74-7f44-8fd1-cde6b5c4d111", "workspace_affinity": {}, "resources": {} }
        },
        "mocks": {
          "prepare_source": { "output": { "repository": "https://example.invalid/repo.git", "revision": "abc123", "sha": "abc123", "workspace": "/workspace" } }
        },
        "expect": { "status": "succeeded", "reached": ["prepare_source"] }
      },
      {
        "name": "parses a declared research route",
        "workflow": "Critique Research Mission",
        "input": {
          "request": { "goal": "critique the research" },
          "mission": { "kind": "research_report", "correlation_key": "critique-test", "requested_by": "test", "source": { "repository": "https://example.invalid/repo.git", "revision": "abc123" } },
          "orchestration": { "binding_id": "018f5f7c-4b74-7f44-8fd1-cde6b5c4d111", "workspace_affinity": {}, "resources": {} }
        },
        "mocks": { "critique": { "output": { "response": { "result": "{\"next_member\":\"runinator.missions.research_report\",\"summary\":\"complete\",\"gaps\":[],\"confidence\":\"high\"}" } } } },
        "expect": { "status": "succeeded" }
      }
    ]
  }
}

settings {
    @schema({ type: ["string", "null"] })
    config prompts.coding_implement = null
    @schema({ type: ["string", "null"] })
    config prompts.coding_review = null
    @schema({ type: ["string", "null"] })
    config prompts.coding_verify = null
    @schema({ type: ["string", "null"] })
    config prompts.coding_summary = null
    @schema({ type: ["string", "null"] })
    config prompts.research_investigate = null
    @schema({ type: ["string", "null"] })
    config prompts.research_critique = null
    @schema({ type: ["string", "null"] })
    config prompts.research_report = null
}
